{
  "name": "xiguchat-server",
  "version-semver": "1.0.0",
  "description": "XiguChat backend microservices (CMake build)",
  "builtin-baseline": "b8b8df2201ad8509b81a830fe0957bcb98e06c27",
  "dependencies": [
    "boost-asio",
    "boost-beast",
    "boost-filesystem",
    "boost-mysql",
    "boost-property-tree",
    "boost-uuid",
    {
      "name": "grpc",
      "features": [
        "codegen"
      ]
    },
    "hiredis",
    "jsoncpp",
    "libsodium",
    {
      "name": "poco",
      "features": [
        "net",
        "netssl"
      ]
    },
    "protobuf",
    "spdlog"
  ]
}
