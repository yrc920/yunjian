# GateServer 配置模板：复制为 config.ini 后按本机修改
[GateServer]
Port = 8080
# HTTPS：SslCert 与 SslKey 都填才启用（端口仍是上面的 Port），留空按明文 HTTP 服务。
# 证书用 fullchain（叶子 + 中间 CA），私钥不要再带口令；续期后覆盖这两个文件即可，
# 进程每 SslReloadSeconds 秒比对一次 mtime，变化后自动换新证书，不用重启
SslCert =
SslKey =
SslReloadSeconds = 60
# 口令哈希线程：Argon2id 单次约 40ms、占 64MiB，不能占用 HTTP IO 线程。
# Threads 就是同时进行的哈希数，也是内存上界（默认 2 => 峰值约 128MiB）
[Password]
Threads = 2
# 排队上限，满了直接回 1101 让客户端重试。队列只影响排队时间，
# 内存由 Threads 决定，所以 9 点登录高峰可以放宽一些
QueueLimit = 128
[VerifyServer]
Host = 127.0.0.1
Port = 50051
[StatusServer]
Host = 127.0.0.1
Port = 50052
[Mysql]
Host = 127.0.0.1
# 经典协议端口（Boost.MySQL）
Port = 3306
# 单条查询的 deadline（毫秒），到点由 Asio 取消，连接仍可复用
QueryTimeoutMs = 5000
User = root
Passwd = 123456
Schema = yunjian
[Redis]
Host = 127.0.0.1
Port = 6380
Passwd = 123456

# 日志：控制台 + 轮转文件 logs/<服务名>.log
# Level 可选 trace/debug/info/warn/error/critical/off；排障时临时调 debug
[Log]
Level = info
Dir = logs
FileMaxMB = 32
FileCount = 5
Console = 1
