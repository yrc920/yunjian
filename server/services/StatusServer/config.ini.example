# StatusServer 配置模板：复制为 config.ini 后按本机修改
[StatusServer]
Host = 127.0.0.1
Port = 50052
# 资源服务器地址随登录路由下发给客户端，必须是客户端可访问的地址
[ResourceServer]
Host = 127.0.0.1
Port = 9090
[Mysql]
Host = 127.0.0.1
# 经典协议端口（Boost.MySQL）
Port = 3306
User = root
Passwd = 123456
Schema = xigu
[Redis]
Host = 127.0.0.1
Port = 6380
Passwd = 123456
# 允许注册的实例名白名单，逗号分隔；地址与端口由各实例启动时自行上报
# 留空表示接受任意实例注册，仅用于本机调试
[chatservers]
Name = chatserver1,chatserver2

# 日志：控制台 + 轮转文件 logs/<服务名>.log
# Level 可选 trace/debug/info/warn/error/critical/off；排障时临时调 debug
[Log]
Level = info
Dir = logs
FileMaxMB = 32
FileCount = 5
Console = 1
