# ChatServer 实例 1 配置模板：复制为 ChatServer.ini 后按本机修改
[GateServer]
Port = 8080
[VerifyServer]
Host = 127.0.0.1
Port = 50051
[StatusServer]
Host = 127.0.0.1
Port = 50052

[SelfServer]
Name = chatserver1
Host = 0.0.0.0
# 客户端连接的地址：随登录路由下发，0.0.0.0 只用于监听
AdvertiseHost = 127.0.0.1
# 实例间 RPC 的地址；本机部署与 AdvertiseHost 相同
AdvertiseRpcHost = 127.0.0.1
# 期望承载的会话数，状态服务按 sessions/capacity 选路
Capacity = 1000
Port = 8090
RPCPort = 50055
# TLS：两项都填才加密客户端连接，留空按明文 TCP；证书与网关共用同一份
SslCert =
SslKey =
# 证书文件被替换后多久检查一次（秒），0 表示不检查
SslReloadSeconds = 60

[Mysql]
Host = 127.0.0.1
# 经典协议端口（Boost.MySQL）
Port = 3306
User = root
Passwd = 123456
Schema = xigu

[Redis]
Host = 127.0.0.1
Port = 6380
Passwd = 123456

[PeerServer]
Servers = chatserver2

[chatserver2]
Name = chatserver2
Host = 127.0.0.1
Port = 50056

# 消息归档：超过保留期的消息搬到 chat_message_archive 再从主表删除。
# 两个实例都会跑，按 message_id 分批 + INSERT IGNORE，重复执行安全
[Archive]
Enabled = 1
RetentionDays = 365
IntervalHours = 24
BatchSize = 2000
# 启动后多久跑第一次（秒），避免批量重启时同时开搬
FirstDelaySeconds = 300

# 日志：控制台 + 轮转文件 logs/<服务名>.log
# Level 可选 trace/debug/info/warn/error/critical/off；排障时临时调 debug
[Log]
Level = info
Dir = logs
FileMaxMB = 32
FileCount = 5
Console = 1
