# ResourceServer 配置模板：复制为 config.ini 后按本机修改
# 文件按当前工作目录读取，服务启动时要进入自己的产物目录
[SelfServer]
Port = 9090
# TLS：两项都填才加密客户端连接，留空按明文 TCP；证书与网关共用同一份
SslCert =
SslKey =
# 证书文件被替换后多久检查一次（秒），0 表示不检查
SslReloadSeconds = 60

# 上传文件根目录，相对当前工作目录；头像保存在 <Path>/<uid>/<文件名>
[Storage]
Path = storage
# 每用户存储上限（MB），0 表示不限制；上传首片时按用户目录已用空间校验
QuotaMB = 1024
# 上传中断留下的 .part 多久算放弃（小时），超过即被清理线程删除
StaleUploadHours = 24
# 清理线程的巡检间隔（分钟）
SweepMinutes = 60

[Mysql]
Host = 127.0.0.1
# 经典协议端口（Boost.MySQL）
Port = 3306
User = root
Passwd = 123456
Schema = yunjian

[Redis]
Host = 127.0.0.1
Port = 6380
Passwd = 123456

# 在线位置只在状态服务里查，资源服务器不再直接读 Redis 的位置键
[StatusServer]
Host = 127.0.0.1
Port = 50052

# 实例名到 RPC 地址的映射：按状态服务返回的实例名找到对应通道
[ChatServers]
Servers = chatserver1,chatserver2

[chatserver1]
Name = chatserver1
Host = 127.0.0.1
Port = 50055

[chatserver2]
Name = chatserver2
Host = 127.0.0.1
Port = 50056

# 日志：控制台 + 轮转文件 logs/<服务名>.log
# Level 可选 trace/debug/info/warn/error/critical/off；排障时临时调 debug
[Log]
Level = info
Dir = logs
FileMaxMB = 32
FileCount = 5
Console = 1
