# ResourceServer 配置模板：复制为 config.ini 后按本机修改
# 文件按当前工作目录读取，服务启动时要进入自己的产物目录
[SelfServer]
Port = 9090

# 上传文件根目录，相对当前工作目录；头像保存在 <Path>/<uid>/<文件名>
[Storage]
Path = storage

[Mysql]
Host = 127.0.0.1
XPort = 33060
User = root
Passwd = 123456
Schema = xigu

[Redis]
Host = 127.0.0.1
Port = 6380
Passwd = 123456

# 在线位置只在状态服务里查，资源服务器不再直接读 Redis 的位置键
[StatusServer]
Host = 127.0.0.1
Port = 50052

# 实例名到 RPC 地址的映射：按状态服务返回的实例名找到对应通道
[ChatServers]
Servers = chatserver1,chatserver2

[chatserver1]
Name = chatserver1
Host = 127.0.0.1
Port = 50055

[chatserver2]
Name = chatserver2
Host = 127.0.0.1
Port = 50056
