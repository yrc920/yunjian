# 复制为 .env 后按本机填写
# 客户端实际访问的地址：本机测试 127.0.0.1，公网部署填域名或公网 IP
PUBLIC_HOST=127.0.0.1

# 网关端口。默认 8080（明文 HTTP）；启用 HTTPS 后改成 8443，
# 客户端 config.ini 的 port 也要跟着改成 8443
GATE_PORT=8080

# 验证码邮件发送账号。QQ 邮箱的授权码在「设置 → 账号 → POP3/SMTP 服务」生成
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=your_email@qq.com
EMAIL_PASS=your_smtp_auth_code
EMAIL_FROM=your_email@qq.com
