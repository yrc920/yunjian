[GateServer]
Port = __GATE_PORT__
# HTTPS：容器内 /etc/yunjian/certs 下同时存在 fullchain.pem 与 privkey.pem 时由
# start_stack.sh 填入，留空按明文 HTTP 服务
SslCert = __TLS_CERT__
SslKey = __TLS_KEY__
SslReloadSeconds = 60
# 口令哈希线程池：Argon2id 单次 64MiB，不能占住 IO 线程
[Password]
Threads = 2
QueueLimit = 128

[VerifyServer]
Host = 127.0.0.1
Port = 50051
[StatusServer]
Host = 127.0.0.1
Port = 50052
[Mysql]
Host = 127.0.0.1
# 经典协议端口（Boost.MySQL）
Port = 3306
# 单条查询的 deadline（毫秒），到点由 Asio 取消，连接仍可复用
QueryTimeoutMs = 5000
User = root
Passwd = 123456
Schema = yunjian
[Redis]
Host = 127.0.0.1
Port = 6380
Passwd = 123456

# 日志：控制台 + 轮转文件 logs/<服务名>.log
[Log]
Level = info
Dir = logs
FileMaxMB = 32
FileCount = 5
Console = 1
