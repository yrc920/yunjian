[GateServer]
Port = 8080
[VerifyServer]
Host = 127.0.0.1
Port = 50051
[StatusServer]
Host = 127.0.0.1
Port = 50052

# 自身监听地址必须是 0.0.0.0，否则客户端经端口映射连不进来
[SelfServer]
Name = chatserver1
Host = 0.0.0.0
# 客户端经端口映射访问，必须填公网可达地址
AdvertiseHost = __PUBLIC_HOST__
# 实例间 RPC 走容器内部回环，不能用公网地址
AdvertiseRpcHost = 127.0.0.1
# 期望承载的会话数，状态服务按 sessions/capacity 选路
Capacity = 1000
Port = 8090
RPCPort = 50055
# TLS：容器内 /etc/xiguchat/certs 下有证书时由 start_stack.sh 填入，留空按明文 TCP
SslCert = __TLS_CERT__
SslKey = __TLS_KEY__
SslReloadSeconds = 60

[Mysql]
Host = 127.0.0.1
# 经典协议端口（Boost.MySQL）
Port = 3306
User = root
Passwd = 123456
Schema = xigu

[Redis]
Host = 127.0.0.1
Port = 6380
Passwd = 123456

# 对端聊天实例走容器内部 RPC
[PeerServer]
Servers = chatserver2

[chatserver2]
Name = chatserver2
Host = 127.0.0.1
Port = 50056
