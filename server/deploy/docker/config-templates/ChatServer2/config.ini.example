[GateServer]
Port = 8080
[VerifyServer]
Host = 127.0.0.1
Port = 50051
[StatusServer]
Host = 127.0.0.1
Port = 50052

# 自身监听地址必须是 0.0.0.0，否则客户端经端口映射连不进来
[SelfServer]
Name = chatserver2
Host = 0.0.0.0
# 客户端经端口映射访问，必须填公网可达地址
AdvertiseHost = __PUBLIC_HOST__
# 实例间 RPC 走容器内部回环，不能用公网地址
AdvertiseRpcHost = 127.0.0.1
# 期望承载的会话数，状态服务按 sessions/capacity 选路
Capacity = 1000
Port = 8091
RPCPort = 50056

[Mysql]
Host = 127.0.0.1
XPort = 33060
User = root
Passwd = 123456
Schema = xigu

[Redis]
Host = 127.0.0.1
Port = 6380
Passwd = 123456

# 对端聊天实例走容器内部 RPC
[PeerServer]
Servers = chatserver1

[chatserver1]
Name = chatserver1
Host = 127.0.0.1
Port = 50055
