[StatusServer]
Host = 127.0.0.1
Port = 50052
# 资源服务器地址随登录路由下发给客户端，必须是客户端可访问的地址
[ResourceServer]
Host = __PUBLIC_HOST__
Port = 9090
[Mysql]
Host = 127.0.0.1
# 经典协议端口（Boost.MySQL）
Port = 3306
User = root
Passwd = 123456
Schema = xigu
[Redis]
Host = 127.0.0.1
Port = 6380
Passwd = 123456

# 允许注册的实例名白名单；容器内各实例通过 AdvertiseRpcHost 上报控制面地址
[chatservers]
Name = chatserver1,chatserver2
