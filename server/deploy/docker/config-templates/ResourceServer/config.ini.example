[SelfServer]
Port = 9090

# 头像与文件落盘目录，docker-compose 将 resource-data 卷挂到这里
[Storage]
Path = /var/lib/xiguchat/storage

[Mysql]
Host = 127.0.0.1
XPort = 33060
User = root
Passwd = 123456
Schema = xigu

[Redis]
Host = 127.0.0.1
Port = 6380
Passwd = 123456

# 图片上传完成后按 uip_<receiver> 选择实例：更新状态并把下载通知推给接收方
[ChatServers]
Servers = chatserver1,chatserver2

[chatserver1]
Name = chatserver1
Host = 127.0.0.1
Port = 50055

[chatserver2]
Name = chatserver2
Host = 127.0.0.1
Port = 50056
