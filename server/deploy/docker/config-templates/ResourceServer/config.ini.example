[SelfServer]
Port = 9090

# 头像与文件落盘目录，docker-compose 将 resource-data 卷挂到这里
[Storage]
Path = /var/lib/xiguchat/storage

[Mysql]
Host = 127.0.0.1
XPort = 33060
User = root
Passwd = 123456
Schema = xigu

[Redis]
Host = 127.0.0.1
Port = 6380
Passwd = 123456

# 容器内所有服务共用回环地址；图片上传完成后要通知 ChatServer
[ChatServer]
Host = 127.0.0.1
Port = 50055
