[SelfServer]
Port = 9090
# TLS：容器内 /etc/xiguchat/certs 下有证书时由 start_stack.sh 填入，留空按明文 TCP
SslCert = __TLS_CERT__
SslKey = __TLS_KEY__
SslReloadSeconds = 60

# 头像与文件落盘目录，docker-compose 将 resource-data 卷挂到这里
[Storage]
Path = /var/lib/xiguchat/storage
# 每用户存储上限（MB），0 表示不限制
QuotaMB = 1024
# 中断上传的 .part 保留多久（小时）
StaleUploadHours = 24
# 清理线程巡检间隔（分钟）
SweepMinutes = 60

[Mysql]
Host = 127.0.0.1
# 经典协议端口（Boost.MySQL）
Port = 3306
User = root
Passwd = 123456
Schema = xigu

[Redis]
Host = 127.0.0.1
Port = 6380
Passwd = 123456

# 在线位置只在状态服务里查，资源服务器不再直接读 Redis 的位置键
[StatusServer]
Host = 127.0.0.1
Port = 50052

# 实例名到 RPC 地址的映射：按状态服务返回的实例名找到对应通道
[ChatServers]
Servers = chatserver1,chatserver2

[chatserver1]
Name = chatserver1
Host = 127.0.0.1
Port = 50055

[chatserver2]
Name = chatserver2
Host = 127.0.0.1
Port = 50056

# 日志：控制台 + 轮转文件 logs/<服务名>.log
[Log]
Level = info
Dir = logs
FileMaxMB = 32
FileCount = 5
Console = 1
