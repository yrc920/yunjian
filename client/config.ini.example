# 复制为 config.ini 后按本机修改：本机或本地容器用 127.0.0.1，连服务器填域名或公网 IP
# scheme 可选 http / https；port 留空表示用协议默认端口（80 / 443）
[GateServer]
scheme=http
host=127.0.0.1
port=8080

# 聊天（8090/8091）与文件（9090）通道是否走 TLS，必须与服务端证书开关一致
# 开启后 host 必须是证书上的域名，填 IP 会因证书不匹配被拒
[Network]
tls=false

# 客户端日志：文件写在 <AppData>/YunJian/logs/client.log，8 MiB 滚动，保留 3 份
# level 可选 debug / info / warn / error / off；Debug 构建默认 debug 且开控制台，
# Release 构建默认 info、只写文件
# rules 透传给 Qt 的 QT_LOGGING_RULES 语法，例如 "xc.net.debug=false"
[Log]
level=info
console=false
file=true
rules=

# 本地聊天缓存（<AppData>/YunJian/yunjian/users/<uid>/chat.db）
# 共享电脑或要求"退出后不留痕"时可设为 false：不再落盘，历史只从服务端拉取
[Storage]
localCache=true
